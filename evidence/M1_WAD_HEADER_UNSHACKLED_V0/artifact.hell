opr_loop_tmp:
  R_MOVD
  OPR
loop_tmp:
  ?
  U_NOP no_decision
  U_NOP was_C1
  U_NOP was_C10
was_C1:
  R_LOOP2
  MOVD leave_loop
was_C10:
  R_LOOP2
  MOVD loop
no_decision:
  R_OPR
  FLAG1 loop_tmp_ret1 R_FLAG1
  FLAG2 loop_tmp_ret2 R_FLAG2
  FLAG3 loop_tmp_ret3 R_FLAG3
  FLAG4 loop_tmp_ret4 R_FLAG4

init_loop:
  R_MOVD
  LOOP5_rw reset_loop5_successful
  MOVD init_loop
restore_loop4:
  R_MOVD
reset_loop5_successful:
  LOOP4_rw reset_loop4_successful
  MOVD restore_loop4
reset_loop4_successful:
  SKIP_rw_FLAG rw_flag_is_reset
  SKIP_rw_FLAG rw_flag_is_reset
loop:
  R_MOVD
rw_flag_is_reset:
  SKIP_rw_FLAG skip_inner_loop R_SKIP_rw_FLAG
  ROTWIDTH_LOOP1 rotwidth_loop_inner1 R_ROTWIDTH_LOOP1
  ROTWIDTH_LOOP2 rotwidth_loop_inner2 R_ROTWIDTH_LOOP2
  ROTWIDTH_LOOP3 rotwidth_loop_inner3 R_ROTWIDTH_LOOP3

skip_inner_loop:
  R_SKIP_rw_FLAG
  R_MOVD
end_of_inner_loop_body:
  R_MOVD
  ROTWIDTH_LOOP1 rotwidth_loop_inner_always1 R_ROTWIDTH_LOOP1
  ROTWIDTH_LOOP2 rotwidth_loop_inner_always2 R_ROTWIDTH_LOOP2
  ROTWIDTH_LOOP3 rotwidth_loop_inner_always3 R_ROTWIDTH_LOOP3

end_of_loop_body:
  SKIP_rw_FLAG set_skip_flag R_SKIP_rw_FLAG
  LOOP5_rw maybe_set_skipflag
update_skip_flag_finished:
  R_MOVD
  ROT C1 R_ROT
reset_loop_tmp_loop:
  R_FLAG1
  MOVD opr_loop_tmp

maybe_set_skipflag:
  LOOP4_rw set_skip_flag
  R_MOVD MOVD update_skip_flag_finished

set_skip_flag:
  R_SKIP_rw_FLAG
  R_MOVD MOVD update_skip_flag_finished

loop_tmp_ret1:
  LOOP2 reset_loop_tmp_loop
do_twice:
