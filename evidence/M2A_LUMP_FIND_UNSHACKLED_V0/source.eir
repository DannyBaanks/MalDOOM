# M2A_LUMP_FIND: stdin = 8 query bytes + 4x16 directory-record bytes, hex-framed.
# VM scans 4 real records, matches 8-byte name, prints MATCH idx/filepos/size or NOMATCH.
# Layout: 1999 ret slot; 4000-4007 query; 4008+16i records (filepos 0-3 LE, size 4-7 LE, name 8-15).
jmp main
hexpair:
mov D, 0
jlt hex_hi09, A, 48
jgt hex_hiAF, A, 57
sub A, 48
jmp hex_hidone
