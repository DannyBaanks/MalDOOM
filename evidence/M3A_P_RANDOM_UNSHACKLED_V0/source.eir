jgt w10, B, 0
jmp n10
w10:
add D, 48
putc D
mov B, 1
n10:
add A, 48
putc A
putc 10
add BP, 1
jmp draw_loop
draw_done:
load A, 1997
add A, 1
store A, 1997
add SP, 1
jmp tick_loop
ticks_done:
