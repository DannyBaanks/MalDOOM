load D, 6003
jeq lt_ok, D, 0
putc 88
putc 10
exit
lt_ok:
store A, 1997
load D, 6004
store D, 1998
# 3 ticks x 8 draws
mov SP, 0
tick_loop:
jge ticks_done, SP, 3
mov BP, 0
draw_loop:
jge draw_done, BP, 8
load D, 1998
add D, 1
jeq idx_wrap, D, 256
jmp idx_nowrap
idx_wrap:
mov D, 0
idx_nowrap:
store D, 1998
mov A, 5000
add A, D
load A, A
# emit A (0-255) decimal
mov B, 0
mov D, 0
em100:
jlt e100, A, 100
sub A, 100
add D, 1
jmp em100
e100:
jgt w100, D, 0
jgt w100, B, 0
jmp n100
w100:
add D, 48
putc D
mov B, 1
n100:
mov D, 0
em10:
