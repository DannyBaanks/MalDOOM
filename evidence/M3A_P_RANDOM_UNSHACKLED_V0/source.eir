# decode leveltime 4B LE -> A, check top byte 0 (24-bit)
mov BP, 6000
mov SP, 5
dec_loop:
jeq dec_done, SP, 0
mov C, dec_ret
store C, 1999
getc A
getc B
jmp hexpair
dec_ret:
store D, BP
add BP, 1
sub SP, 1
jmp dec_loop
dec_done:
load D, 6000
mov A, D
load D, 6001
mov B, D
add B, B
