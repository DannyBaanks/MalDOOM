# M3A_P_RANDOM: Doom P_Random ticks inside the VM. Table = vendored rndtable.
# stdin: leveltime(4B LE) + prndindex(1B), hex-framed = 10 chars.
jmp main
hexpair:
mov D, 0
jlt hex_hi09, A, 48
jgt hex_hiAF, A, 57
sub A, 48
jmp hex_hidone
hex_hiAF:
jlt hex_hierr, A, 65
jgt hex_hiAF2, A, 70
sub A, 55
jmp hex_hidone
