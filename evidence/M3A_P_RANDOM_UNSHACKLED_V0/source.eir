jlt hex_hierr, A, 97
jgt hex_hierr, A, 102
sub A, 87
hex_hidone:
mov D, A
add D, D
add D, D
add D, D
add D, D
jlt hex_lo09, B, 48
jgt hex_loAF, B, 57
sub B, 48
add D, B
load C, 1999
jmp C
hex_loAF:
jlt hex_loerr, B, 65
jgt hex_loAF2, B, 70
sub B, 55
add D, B
load C, 1999
jmp C
hex_loAF2:
jlt hex_loerr, B, 97
jgt hex_loerr, B, 102
sub B, 87
add D, B
load C, 1999
jmp C
hex_hi09:
hex_lo09:
hex_hierr:
hex_loerr:
putc 72
putc 10
exit
